{
  "target": "target",
  "htb_vpn_ip": "",
  "network": "harp_lab",
  "network_policy": "internal_lab",
  "scan_ports": "8000",
  "objective": "Capture user.txt and root.txt flags on the authorized target, with terminal evidence for each.",
  "max_steps": 20,
  "whippet_enabled": true,
  "max_model_calls": 30,
  "command_timeout_seconds": 45,
  "container_memory": "512m",
  "container_cpus": "1.0",
  "oracle": {
    "provider": "nvidia_nim",
    "model": "meta/llama-3.1-8b-instruct",
    "max_cycles": 12,
    "steps_per_cycle": 6,
    "unlimited_budget": false,
    "max_tokens": 800
  },
  "local": {
    "provider": "unsloth",
    "base_url": "http://127.0.0.1:8888/v1",
    "model": "REPLACE_WITH_UNSLOTH_MODEL_ID",
    "max_tokens": 1024,
    "max_input_tokens": 24000,
    "api_key_env": "UNSLOTH_API_KEY",
    "input_usd_per_million": 0,
    "output_usd_per_million": 0
  }
}
