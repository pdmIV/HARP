FROM kalilinux/kali-rolling

ARG WHIPPET_REF=main
COPY scripts/install-dependencies.sh /usr/local/share/harp/install-dependencies.sh
RUN sed -i 's/\r$//' /usr/local/share/harp/install-dependencies.sh \
    && bash /usr/local/share/harp/install-dependencies.sh --system --whippet-ref "$WHIPPET_REF" \
    && setcap cap_net_raw+ep /usr/lib/nmap/nmap \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 harp

USER harp
WORKDIR /workspace
CMD ["sleep", "infinity"]
